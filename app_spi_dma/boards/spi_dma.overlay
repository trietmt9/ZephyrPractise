/ {
    aliases {
        myspi = &spi1;
        mycs = &mycs_gpio;
    };

    gpio_cs {
        compatible = "gpio-keys";
        mycs_gpio: mycs {
            gpios = <&gpioa 4 GPIO_ACTIVE_LOW>;
            label = "SPI CS Pin";
        };
    };
};

&spi1 {
    status = "okay";
    pinctrl-0 = <&spi1_sck_pa5 &spi1_miso_pa6 &spi1_mosi_pa7>;
    pinctrl-names = "default";
    cs-gpios = <&gpioa 4 GPIO_ACTIVE_LOW>;

    /* DMA configuration for SPI1 */
    dmas = <&dma2 3 3 0x20440 0x03>,  /* SPI1_TX: DMA2 Stream 3 Channel 3 */
           <&dma2 0 3 0x20480 0x03>;  /* SPI1_RX: DMA2 Stream 0 Channel 3 */
    dma-names = "tx", "rx";

    spi_device: spi-device@0 {
        compatible = "zephyr,spi-device";
        reg = <0>;
        spi-max-frequency = <2000000>; /* 2 MHz */
        label = "SPI_DEVICE_DMA";
    };
};

&dma2 {
    status = "okay";
};
